{
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "htmlWhitespaceSensitivity": "ignore",
  "plugins": ["prettier-plugin-svelte"],
  "overrides": [
    { "files": "*.svelte", "options": { "parser": "svelte" } },
    { "files": "README.md", "options": { "printWidth": 80, "proseWrap": "always" } }
  ]
}
